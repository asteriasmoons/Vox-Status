# Vox Status Page — environment reference
#
# This file documents the secrets/config the app expects. Copy it to `.env`
# for local notes if you like — but the real values are NOT loaded from here.
#
# In production, DASHBOARD_PASSWORD is a Cloudflare Worker secret, set with:
#
#   npx wrangler secret put DASHBOARD_PASSWORD
#
# For local development with `wrangler dev`, put it in a `.dev.vars` file
# (already gitignored) instead:
#
#   DASHBOARD_PASSWORD=your-local-password

# The password used to sign in to the /dashboard.
DASHBOARD_PASSWORD=change-me

# Telegram publishing (dashboard-side). Reuses the existing Vox bot.
# The bot token must remain server-only — it is proxied through the Worker
# and is NEVER exposed to the browser. Set as production secrets with:
#
#   npx wrangler secret put BOT_TOKEN
#   npx wrangler secret put TELEGRAM_CHANNEL_ID
#
# TELEGRAM_CHANNEL_ID may be the numeric channel id (e.g. 1003999652941 —
# the Worker auto-prefixes -100 when needed) or a fully-qualified id like
# -1003999652941 / @your_channel.
BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
