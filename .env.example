# Vox Status Page — environment reference
#
# This file documents the secrets/config the app expects. Copy it to `.env`
# for local notes if you like — but the real values are NOT loaded from here.
#
# In production, DASHBOARD_PASSWORD is a Cloudflare Worker secret, set with:
#
#   npx wrangler secret put DASHBOARD_PASSWORD
#
# For local development with `wrangler dev`, put it in a `.dev.vars` file
# (already gitignored) instead:
#
#   DASHBOARD_PASSWORD=your-local-password

# The password used to sign in to the /dashboard.
DASHBOARD_PASSWORD=change-me
